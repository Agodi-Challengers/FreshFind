# Used by `npm run dev` for everyone on the team.
# Chat: json = FreshFind Assistant from public/data/chatbot.json (default),
#       tawk = Tawk.to live chat, none = off.
# These Tawk.to IDs are public (they appear in the page source of any site
# that embeds the widget), so it is safe to keep them in the repo.
# For production, set the same variables in the hosting dashboard.
VITE_CHAT_PROVIDER=json
VITE_TAWK_PROPERTY_ID=6ab7ed0e004d41343f7da325
VITE_TAWK_WIDGET_ID=1k3f7c0a6
