# Live chat provider: tawk or none
#   tawk -> the "Ask FreshFind" button opens Tawk.to
#   none -> no chat script loads and the button is hidden
VITE_CHAT_PROVIDER=tawk

# Tawk.to chat widget (Tawk dashboard -> Administration -> Chat Widget).
# The embed link looks like https://embed.tawk.to/<PROPERTY_ID>/<WIDGET_ID>
VITE_TAWK_PROPERTY_ID=
VITE_TAWK_WIDGET_ID=
